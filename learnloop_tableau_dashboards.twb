      <column caption='Overall ROAS' datatype='real' name='[Calculation_2323300782772224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([REVENUE]) / SUM([AD_SPEND])' />
      </column>
      <column caption='Overall CAC' datatype='real' name='[Calculation_2323300786077697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AD_SPEND]) / SUM([CUSTOMERS])' />
